  "model": "deepseek-flash",
  "output_config": {
    "effort": "high"
  },
  "stream": true,
  "system": "You are AIOS, a coding agent. Your working directory is <CWD>.\n\nUse the read tool — not shell commands like cat — to inspect text files. Use offset and limit to continue reading large files.\n\nCheck the [exit code: N] marker on every bash result; investigate failures before moving on.\n\nRead an existing file before overwriting it with write; prefer edit for targeted changes.\n\nRead a file before editing it, unless you just created or edited it in this session.\n\nPrefer apply_patch over separate edit calls for changes across files or separated regions. Read a file before updating, deleting, or moving it, unless you just created or edited it in this session. The whole patch is checked first and a rejected patch changes nothing; once applying starts, operations run in order, stop at the first failure, and are not rolled back, so re-read affected files before retrying when needed.",
  "thinking": {
    "type": "enabled"
  },
  "tools": [
    {
      "description": "Read a UTF-8 text file and return line-numbered content.",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "Path to read, resolved by the filesystem backend.",
            "type": "string"
          },
          "limit": {
            "description": "Maximum number of lines to return. Defaults to 2000.",
            "type": "number"
          },
          "offset": {
            "description": "1-based first line to return. Defaults to 1.",
            "type": "number"
          }
        },
        "required": [
          "file_path"
        ],
        "type": "object"
      },
      "name": "read"
    },
    {
      "description": "Find files, not directories, whose paths match a glob pattern, including hidden and ignored files. Returns up to 100 paths in modification-time order; a larger result keeps the first paths.",
      "input_schema": {
        "properties": {
          "path": {
            "description": "Directory to search in. Defaults to the session workspace; a relative path resolves against it.",
            "type": "string"
          },
          "pattern": {
            "description": "Glob pattern to match file paths against (e.g. \"**/*.ts\", \"src/**/*.test.js\"). A pattern with no \"/\" matches the basename at any depth, so \"*\" and \"*.ts\" both search the whole tree; include a separator to anchor the depth.",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "name": "glob"
    },
    {
      "description": "Search file contents with a ripgrep regular expression. Returns matching lines with line numbers, grouped by file. Returns up to 250 matches.",
      "input_schema": {
        "properties": {
          "include": {
            "description": "One glob filter for which files to search (e.g. \"*.ts\", \"*.{js,jsx}\"). Not a list; negation is not supported.",
            "type": "string"
          },
          "path": {
            "description": "File or directory to search. Defaults to the session workspace; a relative path resolves against it.",
            "type": "string"
          },
          "pattern": {
            "description": "Regular expression to search for (ripgrep syntax).",
            "type": "string"
          }
        },
        "required": [
          "pattern"
        ],
        "type": "object"
      },
      "name": "grep"
    },
    {
      "description": "Create or fully replace a UTF-8 text file.",
      "input_schema": {
        "properties": {
          "content": {
            "description": "Full UTF-8 text content to write.",
            "type": "string"
          },
          "file_path": {
            "description": "Path to write, resolved by the filesystem backend. Provide `file_path` before `content` in the arguments.",
            "type": "string"
          }
        },
        "required": [
          "file_path",
          "content"
        ],
        "type": "object"
      },
      "name": "write"
    },
    {
      "description": "Edit an existing UTF-8 text file by replacing literal text.",
      "input_schema": {
        "properties": {
          "file_path": {
            "description": "Path to edit, resolved by the filesystem backend. Provide `file_path` before `old_string` and `new_string` in the arguments.",
            "type": "string"
          },
          "new_string": {
            "description": "Literal replacement text. Use an empty string to delete the match.",
            "type": "string"
          },
          "old_string": {
            "description": "Literal text to replace.",
            "type": "string"
          },
          "replace_all": {
            "description": "Replace all matches. Defaults to false; when false, old_string must appear exactly once.",
            "type": "boolean"
          }
        },
        "required": [
          "file_path",
          "old_string",
          "new_string"
        ],
        "type": "object"
      },
      "name": "edit"
    },
    {
      "description": "Create, update, delete, or move UTF-8 text files with one Codex-style patch; prefer it over multiple edit calls when a change spans several files or separated regions.",
      "input_schema": {
        "properties": {
          "input": {
            "description": "Codex patch text: start with *** Begin Patch and end with *** End Patch. Use *** Add File: path with + lines; *** Update File: path, optionally followed by *** Move to: path, with @@ or @@ context and space-prefixed context, + added, or - removed lines; *** End of File anchors the last hunk to the file end. Use *** Delete File: path to delete. Paths are relative to the Session working directory. Read existing files before updating, deleting, or moving them.",
            "type": "string"
          }
        },
        "required": [
          "input"
        ],
        "type": "object"
      },
      "name": "apply_patch"
    },
    {
      "description": "Execute a bash command (bash -c) and return its stdout/stderr. Each call runs in a fresh shell; pass workdir instead of using cd. Managed $AIOS_* variables expose current harness environment facts. Long output is truncated to its tail; the full output is saved to a file whose path is reported when available. An unset variable expands to an empty string, so guard variables in such paths with ${VAR:?}.",
      "input_schema": {
        "properties": {
          "command": {
            "description": "The bash command to execute.",
            "type": "string"
          },
          "workdir": {
            "description": "Working directory for this command. Defaults to the session workspace; a relative path is resolved against it.",
            "type": "string"
          }
        },
        "required": [
          "command"
        ],
        "type": "object"
      },
      "name": "bash"
